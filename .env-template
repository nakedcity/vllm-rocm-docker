# Container Images
VLLM_IMAGE=vllm/vllm-openai-rocm:v0.20.2
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.4.5

# Model Configuration
MODEL=QuantTrio/gemma-4-31B-it-AWQ
PORT=9500
QUANTIZATION=auto
DTYPE=auto
MAX_MODEL_LEN=16384

# vLLM Performance
GPU_MEMORY_UTILIZATION=0.88
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=2048
PYTORCH_ALLOC_CONF=expandable_segments:True

# ROCm Stability (Default: RDNA 4 / gfx1201 settings)
# These are often overridden by the --architecture flag in run.sh
HSA_OVERRIDE_GFX_VERSION=12.0.1
GPU_ARCHS=gfx1201
HSA_ENABLE_SDMA=0
NCCL_P2P_DISABLE=1
NCCL_IB_DISABLE=1
VLLM_ROCM_USE_AITER=0
HIP_FORCE_DEV_KERNARG=1

# vLLM Engine Configuration
VLLM_USE_TRITON_AWQ=0

# Tool calling: when set, enables --enable-auto-tool-choice with the given parser.
# Common parsers (must match the model's chat template):
#   gemma4    — Google Gemma4 custom <|tool_call>call:NAME{...}<tool_call|> format
#   pythonic  — Gemma 3 / Llama 4 pythonic [func(arg=value)] format
#   hermes    — Hermes / Qwen2.5 <tool_call>{...}</tool_call> JSON format
#   mistral   — Mistral [TOOL_CALLS] format
#   llama3_json — Llama 3.1/3.2 JSON object format
# Leave empty to disable auto tool choice.
TOOL_CALL_PARSER=gemma4

# Hardware / Multi-GPU
HIP_VISIBLE_DEVICES=0

# Secrets (Leave empty in template)
HF_TOKEN=

# Open WebUI
OPENAI_API_KEY=unused-key
